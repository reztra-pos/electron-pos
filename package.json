{
  "name": "reztra-pos",
  "private": true,
  "version": "1.1.0",
  "description": "Reztra POS \u2014 Electron + React desktop app for Windows",
  "author": "Reztra",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron . --ozone-platform=x11\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron . --ozone-platform=x11",
    "dist": "vite build && electron-builder --win",
    "mock-api": "node scripts/mock-api.mjs",
    "make-key": "node scripts/make-key.mjs"
  },
  "build": {
    "appId": "com.reztra.pos",
    "productName": "Reztra POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
